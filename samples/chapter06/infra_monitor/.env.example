# Amazon Bedrock（Claude）の認証。~/.aws/config の oic プロファイルを使う
# LiteLLM経由でboto3の標準認証チェーンが使われるため、プロファイル名だけ指定すればよい
AWS_PROFILE=oic
# プロファイルにregionが設定されていない場合のみ指定する
# AWS_REGION=ap-northeast-1

# Athena MCPサーバーを接続する場合だけ 1 にする
ENABLE_ATHENA_MCP=0

# Athenaのワークグループ。クエリ結果の保存先（S3）を設定済みのものを指定する
# ATHENA_WORKGROUP=primary
