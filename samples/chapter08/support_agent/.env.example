# Amazon Bedrock（Claude）の認証。~/.aws/config の oic プロファイルを使う
# LiteLLM経由でboto3の標準認証チェーンが使われるため、プロファイル名だけ指定すればよい
AWS_PROFILE=oic
# プロファイルにregionが設定されていない場合のみ指定する
# AWS_REGION=ap-northeast-1

# Agent Engine / Cloud Runへデプロイする場合のGoogle Cloud設定
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
