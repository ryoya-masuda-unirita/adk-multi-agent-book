# Amazon Bedrock（Claude）の認証。~/.aws/config の oic プロファイルを使う
# LiteLLM経由でboto3の標準認証チェーンが使われるため、プロファイル名だけ指定すればよい
AWS_PROFILE=oic
# プロファイルにregionが設定されていない場合のみ指定する
# AWS_REGION=ap-northeast-1

# AgentCore Runtimeへデプロイする場合の設定（deploy/deploy.sh・deploy/deploy_sdk.py で使用）
# AGENTCORE_ROLE_ARN=arn:aws:iam::123456789012:role/your-agentcore-role
# CODE_BUCKET=your-code-bucket
