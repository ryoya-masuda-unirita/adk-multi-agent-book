# Amazon Bedrock（Claude）の認証。~/.aws/config の oic プロファイルを使う
# LiteLLM経由でboto3の標準認証チェーンが使われるため、プロファイル名だけ指定すればよい
AWS_PROFILE=oic
# プロファイルにregionが設定されていない場合のみ指定する
# AWS_REGION=ap-northeast-1

# 実行環境（dev / staging / prod）
AGENT_ENV=dev

# Memory Bankの有効化（true / false）
ENABLE_MEMORY_BANK=false

# Vertex AI Memory Bank を使用する場合（staging / prod）。Google Cloudのリソースが必要
# GCP_PROJECT=your-project-id
# GCP_LOCATION=us-central1
# AGENT_ENGINE_ID=your-agent-engine-id

# DatabaseSessionService用（staging）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_db

# DatabaseSessionService用（prod）。Amazon RDS（PostgreSQL）に接続する
# RDS_ENDPOINT=mydb.xxxx.ap-northeast-1.rds.amazonaws.com
# DB_USER=app-user
# DB_PASSWORD=your-password
# DB_NAME=agent_db

# RAG Engine用（オプション）。Google Cloudのリソースが必要
# RAG_CORPUS_ID=your-corpus-id
