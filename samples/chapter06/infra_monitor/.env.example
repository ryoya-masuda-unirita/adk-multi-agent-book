# Amazon Bedrock（Claude）の認証。~/.aws/config の oic プロファイルを使う
# LiteLLM経由でboto3の標準認証チェーンが使われるため、プロファイル名だけ指定すればよい
AWS_PROFILE=oic
# プロファイルにregionが設定されていない場合のみ指定する
# AWS_REGION=ap-northeast-1

# Google Cloud プロジェクトID（BigQuery MCP サーバー用）
GCP_PROJECT_ID=your-project-id

# BigQuery MCP Toolboxを接続する場合だけ 1 にする
ENABLE_BIGQUERY_MCP=0
